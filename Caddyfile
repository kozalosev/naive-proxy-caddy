{
    email "{$ADMIN_EMAIL}"
    order forward_proxy before reverse_proxy
}

:443, "{$PROXY_DOMAIN}" {

    tls "{$ADMIN_EMAIL}"
    encode gzip zstd

    forward_proxy {
        import /run/secrets/auth_users
        hide_ip
        hide_via
        probe_resistance
    }

    reverse_proxy "{$FALLBACK_WEBSITE}" {
        header_up Host {upstream_hostport}
    }
}
